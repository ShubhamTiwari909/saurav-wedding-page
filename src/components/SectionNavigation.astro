---
interface Props {
	sections: { id: string; label: string }[];
}

const { sections } = Astro.props;
---

<nav class="fixed right-8 top-1/2 z-10 hidden -translate-y-1/2 gap-4 md:grid" aria-label="Wedding sections">
	<div class="absolute left-1/2 top-1.5 -z-10 h-[calc(100%-12px)] w-px -translate-x-1/2 bg-[#b18b3c]/50"></div>
	<div class="garland-progress absolute left-1/2 top-1.5 -z-10 h-0 w-[3px] -translate-x-1/2 rounded-full bg-[#c8a75d] transition-[height] duration-500"></div>
	{sections.map((section) => (
		<a
			class="group relative block h-3.25 w-3.25 rounded-full border border-[#b58b3a] bg-[#f7f2e8] p-0.75"
			href={`#${section.id}`}
			aria-label={`Go to ${section.label}`}
			data-label={section.label}
		>
			<span class="block h-full w-full rounded-full transition-colors group-hover:bg-[#ae8230]"></span>
			<span class="pointer-events-none absolute right-6 -top-0.75 w-max translate-x-1 opacity-0 font-sans text-[.58rem] uppercase tracking-[.15em] text-[#9a7838] transition-all group-hover:translate-x-0 group-hover:opacity-100">{section.label}</span>
		</a>
	))}
</nav>
