---
import type { WeddingEvent } from '../data';

interface Props {
	events: WeddingEvent[];
}

const { events } = Astro.props;
---

<div class="relative z-10 mt-16 w-full max-w-5xl px-2">
	<div class="mb-7 text-center font-sans text-[.62rem] uppercase tracking-[.3em] text-[#98752f]">Four days of celebration</div>
	<div class="relative grid grid-cols-4 gap-3 max-md:grid-cols-2 max-md:gap-y-8">
		<div class="absolute left-[12%] right-[12%] top-3 border-t border-dashed border-[#c8a75d]/60 max-md:left-[12%] max-md:right-[12%] max-md:top-3"></div>
		{events.map((event, index) => (
			<a class="timeline-stop group relative z-10 text-center" href={`#${event.id}`} data-timeline-id={event.id}>
				<span class="mx-auto mb-3 grid h-6 w-6 place-items-center rounded-full border border-[#c8a75d] bg-[#f7f2e8] font-display text-sm text-[#98752f] transition-colors group-hover:bg-[#c8a75d] group-hover:text-white">{index + 1}</span>
				<strong class="block font-display text-xl text-[#5b482d]">{event.title}</strong>
				<span class="mt-1 block font-sans text-[.57rem] uppercase tracking-[.16em] text-[#98752f]">{event.dateLabel.split(',')[0]}</span>
			</a>
		))}
	</div>
</div>
